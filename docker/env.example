# Local domain FQDN (required)
LOCAL=example.org

# Postmaster password for local domain (default: empty)
# If empty, random password will be generated
#PASSWORD=

# Run mode (default: native):
# original - tcpserver + original /var/qmail/bin/qmail-smtpd
# compat   - tcpserver + my-qmail-smtpd (qmail-compatible)
# native   - run my-qmail-smtpd as standalone server
# maintenance - no services, shell access only
#RUN_MODE=native

# Logging level (default: INFO): DEBUG, INFO, WARN, ERROR
#LOG_LEVEL=INFO

# Enable SMTP session logging (requires DEBUG level, default: 0)
# 1-enable / 0-disable
#SMTPLOG=0

# Allow unsafe authentication (LOGIN, PLAIN) without STARTTLS (default: 0)
# 1-allow / 0-deny (recommended for testing only)
#UNSAFE_AUTH=0

# SMTP server port (default: 25)
#PORT=25

# Additional environment variables for debugging
# QMAILQUEUE=/var/qmail/bin/qmail-queue
# VPOPMAIL=/home/vpopmail
